{
  "manifest_version": 3,
  "name": "Задачи и сметы",
  "version": "0.2.0",
  "description": "Добавляет задачи менеджеров в таблицу и записывает сметы (итог с НДС и ссылку с ВБ Диска) без захода в таблицу.",
  "action": { "default_title": "Задачи и сметы" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "clipboardRead"],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ]
}
