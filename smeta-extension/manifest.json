{
  "manifest_version": 3,
  "name": "Задачи и сметы",
  "version": "1.6.0",
  "description": "Добавляет задачи менеджеров в таблицу, показывает ваши открытые задачи, записывает сметы и создаёт задачи в трекере из сообщений Band — без захода в таблицу.",
  "action": {
    "default_title": "Задачи и сметы",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "alarms",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://disk.wb.ru/*",
    "https://tracker.wb.ru/*",
    "https://band.wb.ru/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://band.wb.ru/*"
      ],
      "js": [
        "band.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
