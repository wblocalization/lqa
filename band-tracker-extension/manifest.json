{
  "manifest_version": 3,
  "name": "Band → Трекер",
  "version": "2.2.0",
  "description": "Тикеты в tracker.wb.ru из треда Band: кнопка «Создать тикет» у сообщения — название, языки, подзадачи по языкам и ответ в тред со ссылками.",
  "action": {
    "default_title": "Band → Трекер",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "contextMenus", "scripting", "clipboardWrite"],
  "host_permissions": ["https://band.wb.ru/*", "https://tracker.wb.ru/*"],
  "content_scripts": [
    { "matches": ["https://band.wb.ru/*"], "js": ["band.js"], "run_at": "document_idle" },
    { "matches": ["https://tracker.wb.ru/*"], "js": ["tracker-hook.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://tracker.wb.ru/*"], "js": ["tracker-bridge.js"], "run_at": "document_start" }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
